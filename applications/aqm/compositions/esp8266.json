{
  "platform": "ESP8266",
  "board": "esp8266/boards/d1_mini.json",
  "buses": {
    "main": {
      "kind": "i2c",
      "sda": 4,
      "scl": 5
    }
  },
  "modules": [
    {
      "id": "bmp",
      "module": "BMP180",
      "bindings": {
        "bus": "main",
        "address": 119
      }
    },
    {
      "id": "dht",
      "module": "DHT11",
      "bindings": {
        "data": 14
      }
    }
  ],
  "features": [
    "state",
    "input",
    "cs",
    "ter",
    "routine"
  ],
  "flags": [],
  "variables": {
    "master": "192.168.0.18"
  },
  "osc": {
    "port": 9000
  },
  "pending_ter": {
    "triggers": {
      "sample_timer": {
        "condition": {
          "interval_ms": 5000
        },
        "state": 0
      }
    },
    "events": {
      "sample_event": {
        "trigger": "sample_timer",
        "commands": [
          "run aqm_sample"
        ]
      }
    },
    "runners": {
      "aqm_sample": {
        "state": 0,
        "commands": [
          "um.bmp.read",
          "um.dht.read",
          "osc.out $master #I:sensorit:data"
        ]
      }
    }
  }
}
