{
  "version": 1,
  "language": "C99",
  "runtime": {
    "hardcore": {
      "path": "embedded/hardcore",
      "dependencies": [],
      "features": [
        "state",
        "cs",
        "ter",
        "routine",
        "input"
      ]
    },
    "core": {
      "path": "embedded/core",
      "dependencies": [],
      "features": [
        "validate"
      ],
      "planned_features": [
        "expression"
      ]
    }
  },
  "external": {
    "platform_adapters": "embedded/adapters",
    "user_modules": "embedded/modules",
    "node_manager": "node_manager",
    "applications": "applications"
  },
  "input": {
    "namespaces": {
      "physical": "#I",
      "osc": "#OSC"
    },
    "namespace_owner": "module",
    "route": [
      "input_module",
      "state"
    ]
  },
  "output": {
    "route": [
      "command",
      "output_module"
    ]
  },
  "build": {
    "framework": null,
    "allocation": "caller_owned",
    "features": "compile_time",
    "optional_flags": {
      "AIGMOS_ACCESSCORE": "cs_authorization_hook"
    }
  },
  "registries": {
    "trigger": {
      "fields": [
        "condition",
        "state"
      ],
      "state": [
        0,
        1
      ]
    },
    "event": {
      "fields": [
        "trigger",
        "commands"
      ],
      "state_owner": "trigger"
    },
    "runner": {
      "fields": [
        "state",
        "commands"
      ]
    },
    "expression": {
      "fields": [
        "expression"
      ],
      "independent_of": "ter",
      "status": "planned"
    }
  }
}
